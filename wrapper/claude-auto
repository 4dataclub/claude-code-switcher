#!/usr/bin/env bash
# claude-auto — startet Claude Code mit Quota-Detection und Auto-Failover.
# Bei 90 %-Warnung → macOS-Notification + Switcher-UI-Banner.
# Bei 100 %-Quota-Fehler → fragt Switcher (wenn Auto-Modus an) → killt + restart mit --resume.
#
# Usage: claude-auto [<claude-args>...]

set -uo pipefail
# Job-Status-Reports ('Terminated: 15' beim Killen der Background-Watcher) abschalten
set +m

SWITCHER_URL="${CLAUDE_SWITCHER_URL:-http://localhost:2000}"
# CLAUDE_BIN: das ECHTE claude binary, nicht der Alias zu uns selbst
CLAUDE_BIN="${CLAUDE_BIN:-/Users/data/.local/bin/claude}"
# Falls der Default-Pfad nicht existiert, fallback auf 'command claude' suchen
if [[ ! -x "$CLAUDE_BIN" ]]; then
  CLAUDE_BIN=$(command -v claude 2>/dev/null || echo "claude")
fi

# Subcommands die direkt durchgereicht werden (kein Wrapper-Verhalten)
# 'auth' für login/logout/status — sonst würde der Wrapper sich selbst aufrufen
if [[ $# -ge 1 ]]; then
  case "$1" in
    auth|setup-token|--help|-h|--version|-v|version|help|update)
      exec "$CLAUDE_BIN" "$@"
      ;;
  esac
fi

# Zombie-Wrapper aufräumen: ein abgebrochenes Terminal hinterlässt manchmal
# claude-auto-Bash-Prozesse die nicht mehr in einem TTY hängen aber weiter
# Marker-Watcher laufen lassen — die fressen dann UI-Switch-Marker bevor unser
# echter Wrapper sie sieht. Nur Zombies (ohne running claude-binary darunter)
# werden gekillt; aktive Sessions in anderen Terminals bleiben unberührt.
MY_WRAPPER_PID=$$
for stale_pid in $(pgrep -f "bash.*claude-auto" 2>/dev/null); do
  [[ "$stale_pid" == "$MY_WRAPPER_PID" ]] && continue
  # Lebt es überhaupt + hat es einen claude-Subprozess?
  # Wir matchen auf das volle CLAUDE_BIN-Pfad, sodass sowohl `claude` als auch
  # `claude --bare ...` erfasst werden.
  if kill -0 "$stale_pid" 2>/dev/null && \
     ! pgrep -P "$stale_pid" -f "$CLAUDE_BIN" >/dev/null 2>&1; then
    kill -KILL "$stale_pid" 2>/dev/null || true
  fi
done
# Verwaiste tail-Subprozesse von Zombies einsammeln
pkill -KILL -f "tail -F /var/folders/.*/claude-auto-" 2>/dev/null || true
pkill -KILL -f "tail -F /tmp/claude-auto-" 2>/dev/null || true

# Patterns (anpassbar wenn Claude Code seine Strings ändert)
WARN_RE='approach.*usage|messages.*remaining|90% of|usage.*nearly|quota.*near'
ERROR_RE='usage_limit_exceeded|rate_limit_exceeded|quota.*exceeded|HTTP 429|usage limit reached'

notify() {
  local msg="$1"
  if command -v osascript >/dev/null 2>&1; then
    osascript -e "display notification \"${msg//\"/\\\"}\" with title \"Claude Switcher\" sound name \"Pop\"" 2>/dev/null || true
  fi
  echo "" >&2
  echo "▸ Switcher: $msg" >&2
}

post_json() {
  local path="$1" data="$2"
  curl -sS --max-time 5 -X POST "${SWITCHER_URL}${path}" \
    -H 'Content-Type: application/json' -d "$data" 2>/dev/null
}

# Säubert alle 'thinking' content-blocks aus einer Session-JSONL.
# Hintergrund: Cross-Provider-Switch (z.B. Gemini Pro → Anthropic Opus) führt zu
# 400 "Invalid signature in thinking block" weil Anthropic die Signaturen prüft.
strip_thinking_from_session() {
  local sid="$1"
  local cwd_dash="${PWD//\//-}"
  local cwd_full_dash="${cwd_dash//_/-}"
  for variant in "$cwd_dash" "$cwd_full_dash"; do
    local jsonl="$HOME/.claude/projects/$variant/$sid.jsonl"
    if [[ -f "$jsonl" ]]; then
      python3 - "$jsonl" <<'PYEOF' 2>/dev/null || true
import json, sys
path = sys.argv[1]
out, removed = [], 0
try:
    with open(path) as f:
        for line in f:
            try:
                obj = json.loads(line)
                if isinstance(obj, dict) and isinstance(obj.get('message'), dict):
                    content = obj['message'].get('content')
                    if isinstance(content, list):
                        new = [b for b in content if not (isinstance(b, dict) and b.get('type') == 'thinking')]
                        if len(new) != len(content):
                            removed += len(content) - len(new)
                            obj['message']['content'] = new
                out.append(json.dumps(obj))
            except Exception:
                out.append(line.rstrip('\n'))
    if removed > 0:
        with open(path, 'w') as f:
            for line in out:
                f.write(line + '\n')
        sys.stderr.write(f"↪ {removed} thinking-blocks aus Session entfernt (Cross-Provider-Schutz)\n")
except Exception:
    pass
PYEOF
      return 0
    fi
  done
}

# Findet die zuletzt modifizierte JSONL im **cwd-spezifischen** Projects-Verzeichnis.
# Claude Code encoded den cwd-Pfad: '/Users/foo/bar' → '-Users-foo-bar'.
# Wichtig: NICHT im gesamten Tree suchen, sonst kriegen wir UUIDs aus anderen Projekten,
# und `claude --resume <uuid>` schlägt fehl mit "No conversation found".
find_latest_session_id() {
  # Encoding-Varianten probieren — Claude Code's Encoding ist nicht 100% konsistent
  local cwd_dash="${PWD//\//-}"               # / → -
  local cwd_full_dash="${cwd_dash//_/-}"      # _ → - (manche Versionen)
  local dir
  for variant in "$cwd_dash" "$cwd_full_dash"; do
    dir="$HOME/.claude/projects/$variant"
    if [[ -d "$dir" ]]; then
      local latest
      latest=$(ls -t "$dir"/*.jsonl 2>/dev/null | head -1)
      if [[ -n "$latest" ]]; then
        basename "$latest" .jsonl
        return 0
      fi
    fi
  done
  return 1
}

# Outer Loop: ein Durchlauf pro Claude-Code-Lebenszyklus.
# Bei Quota-Failover wird ein Marker-File geschrieben → wir resumen mit --resume.
RESUME_ID=""
while true; do
  # Wenn beim Loop-Start schon ein Restart-Marker liegt (UI-Switch kam genau
  # zwischen claude-Exit und neuem Loop-Start, BEVOR der Marker-Watcher der
  # neuen Iteration startet), verarbeiten wir ihn sofort: settings.json neu
  # lesen indem wir die nächste Iteration mit Resume starten.
  if [[ -f "$HOME/.claude/.switcher-restart" ]]; then
    rm -f "$HOME/.claude/.switcher-restart"
    sid=$(find_latest_session_id)
    [[ -n "$sid" ]] && { RESUME_ID="$sid"; strip_thinking_from_session "$sid"; } \
                     || RESUME_ID="__continue__"
    echo "↪ Stale Switch-Marker beim Wrapper-Start konsumiert → settings.json wird neu gelesen" >&2
  fi

  LOGFILE=$(mktemp -t claude-auto-XXXXXXXX)
  RESTART_FILE="${LOGFILE}.restart"
  trap 'rm -f "$LOGFILE" "$RESTART_FILE" 2>/dev/null' EXIT

  # ── Background-Watcher 1: stderr-Parsing ────────────────────────────────
  (
    sleep 0.2
    tail -F "$LOGFILE" 2>/dev/null | while IFS= read -r line; do

      # 90 %-Warnung
      if echo "$line" | grep -qiE "$WARN_RE"; then
        notify "Quota bei ~90 % — im Switcher entscheiden"
        post_json /api/warn \
          "{\"percent\":90,\"project\":\"$PWD\",\"source\":\"wrapper-stderr\"}" \
          > /dev/null
      fi

      # 100 %-Fehler → Switcher fragen
      if echo "$line" | grep -qiE "$ERROR_RE"; then
        local_resp=$(post_json /api/quota-error "{\"project\":\"$PWD\"}")
        action=$(echo "$local_resp" | python3 -c \
          "import sys,json; print(json.load(sys.stdin).get('action','notify'))" 2>/dev/null)

        if [[ "$action" == "switch" ]]; then
          notify "Quota erreicht — switche auf Fallback und starte neu"
          touch "$RESTART_FILE"
          pkill -TERM -P "$$" -f "claude" 2>/dev/null || true
          break
        elif [[ "$action" == "exhausted" ]]; then
          notify "Alle Provider voll — manuell entscheiden"
        else
          notify "Quota erreicht — Auto-Modus aus, bleibt bei dir"
        fi
      fi
    done
  ) &
  WATCHER_PID=$!
  disown "$WATCHER_PID" 2>/dev/null || true

  # ── Background-Watcher 2: Switcher-Restart-Marker (Chain-Promote etc.) ─
  # Polling alle 0.3 s (war 1 s) — sonst kommt eine Antwort durch das
  # alte Backend bevor der Watcher den Marker bemerkt.
  # SIGKILL statt SIGTERM, damit claude garantiert sofort beendet
  # (interactive bun-binary fängt SIGTERM gelegentlich ab).
  (
    MARKER="$HOME/.claude/.switcher-restart"
    while true; do
      if [[ -f "$MARKER" ]]; then
        rm -f "$MARKER"
        notify "Switcher fordert Restart — Kontext bleibt erhalten"
        touch "$RESTART_FILE"
        pkill -KILL -P "$$" -f "claude" 2>/dev/null || true
        break
      fi
      sleep 0.3
    done
  ) &
  MARKER_WATCHER_PID=$!
  disown "$MARKER_WATCHER_PID" 2>/dev/null || true

  # ── Env-Variablen aus settings.json laden ─────────────────────────────────
  # Vereinfachte Strategie:
  # - non-Anthropic (Router): Auto-Logout damit OAuth den Router nicht überschreibt
  # - Anthropic-Modus: OAuth aktiv halten (claude auth login einmalig vom User)
  # Long-Token-Trick aufgegeben: claude auth logout invalidiert ihn jedes Mal.
  if command -v python3 >/dev/null 2>&1 && [[ -f "$HOME/.claude/settings.json" ]]; then
    BASE_URL_FROM_SETTINGS=$(python3 -c "import json,sys; d=json.load(open('$HOME/.claude/settings.json')); print(d.get('env',{}).get('ANTHROPIC_BASE_URL',''))" 2>/dev/null)
    API_KEY_FROM_SETTINGS=$(python3 -c "import json,sys; d=json.load(open('$HOME/.claude/settings.json')); print(d.get('env',{}).get('ANTHROPIC_API_KEY',''))" 2>/dev/null)

    if [[ -n "$BASE_URL_FROM_SETTINGS" ]]; then
      # Non-Anthropic-Modus → Router
      # Auto-Logout: --bare allein reicht nicht zuverlässig, OAuth-Keychain
      # überschreibt sonst BASE_URL → claude redet trotzdem zu Anthropic.
      AUTH_LOGGED_IN=$("$CLAUDE_BIN" auth status 2>/dev/null | python3 -c "
import json,sys
try: print('true' if json.load(sys.stdin).get('loggedIn') else 'false')
except: print('unknown')
" 2>/dev/null)
      if [[ "$AUTH_LOGGED_IN" == "true" ]]; then
        echo "↪ Auto-Logout (Keychain leeren — sonst überschreibt OAuth den Router)" >&2
        "$CLAUDE_BIN" auth logout 2>&1 | head -1 | sed 's/^/  /' >&2
      fi
      echo "↪ Provider via Router: $BASE_URL_FROM_SETTINGS" >&2
      export ANTHROPIC_BASE_URL="$BASE_URL_FROM_SETTINGS"
      export ANTHROPIC_API_KEY="$API_KEY_FROM_SETTINGS"
      unset ANTHROPIC_CODE_PROVIDER_MANAGED_BY_HOST
      unset CLAUDE_CODE_OAUTH_TOKEN
    else
      # Anthropic-Modus → OAuth oder Long-Token (wenn vorhanden)
      unset ANTHROPIC_BASE_URL
      unset ANTHROPIC_API_KEY

      # Optional: Long-lived Token aus settings.json _switcher.keys.anthropic
      ANTHROPIC_LONG_TOKEN=$(python3 -c "
import json,sys
try:
    d = json.load(open('$HOME/.claude/settings.json'))
    k = d.get('_switcher', {}).get('keys', {}).get('anthropic', '')
    print(k if k.startswith('sk-ant-oat01-') else '')
except: print('')
" 2>/dev/null)

      # OAuth-Login hat Vorrang vor Long-Token (sonst kein Remote Control).
      # Long-Token nur als Fallback wenn OAuth nicht (mehr) da ist — z.B. nach
      # Provider-Switch der die Keychain geleert hat.
      unset CLAUDE_CODE_OAUTH_TOKEN
      AUTH_LOGGED_IN=$("$CLAUDE_BIN" auth status 2>/dev/null | python3 -c "
import json, sys
try: print('true' if json.load(sys.stdin).get('loggedIn') else 'false')
except: print('false')
" 2>/dev/null)

      if [[ "$AUTH_LOGGED_IN" == "true" ]]; then
        echo "↪ Anthropic via OAuth (Keychain) — Remote Control verfügbar" >&2
      else
        # Keine OAuth-Session → automatisch Login-Flow starten.
        # Hintergrund: Beim Switch auf einen anderen Provider macht der Wrapper
        # 'claude auth logout' (Router-Schutz). Switcht der User später zurück
        # auf Anthropic, ist die OAuth-Session weg → Remote Control bricht.
        # Statt nur einen Hinweis auszugeben, starten wir den Login automatisch,
        # damit der User nur einmal durch den Browser-Flow muss.
        echo "" >&2
        echo "⚠ Anthropic-Modus aktiv, aber keine OAuth-Session." >&2
        echo "↪ Starte 'claude auth login' automatisch (Browser öffnet sich)…" >&2
        echo "" >&2
        notify "Auto-Login wird gestartet — Browser-Flow durchklicken"
        if [[ -e /dev/tty ]]; then
          "$CLAUDE_BIN" auth login </dev/tty >/dev/tty 2>&1 || true
        else
          "$CLAUDE_BIN" auth login >&2 || true
        fi
        # Re-Check nach Login-Versuch
        AUTH_LOGGED_IN_AFTER=$("$CLAUDE_BIN" auth status 2>/dev/null | python3 -c "
import json, sys
try: print('true' if json.load(sys.stdin).get('loggedIn') else 'false')
except: print('false')
" 2>/dev/null)
        if [[ "$AUTH_LOGGED_IN_AFTER" == "true" ]]; then
          echo "↪ Login erfolgreich — Remote Control jetzt verfügbar" >&2
        elif [[ -n "$ANTHROPIC_LONG_TOKEN" ]]; then
          echo "↪ Login nicht durch — fallback auf Long-Token (Remote Control bleibt blockiert)" >&2
          export CLAUDE_CODE_OAUTH_TOKEN="$ANTHROPIC_LONG_TOKEN"
        else
          echo "⚠ Login nicht durch + kein Long-Token. Claude startet trotzdem, wird aber bei API-Call failen." >&2
          notify "Login nicht durch — claude startet ohne Auth"
        fi
      fi
    fi
  fi

  # ── Claude-Flags ──────────────────────────────────────────────────────
  # non-Anthropic-Modus: --bare nötig (sonst checkt claude loggedIn-Status
  # und scheitert mit "Please run /login"). Aber --bare deaktiviert CLAUDE.md
  # auto-discovery → wir geben das Verzeichnis explizit via --add-dir mit,
  # damit User trotzdem via Chat switchen kann ("wechsel auf X").
  CLAUDE_FLAGS=()
  if [[ -n "${ANTHROPIC_BASE_URL:-}" ]]; then
    CLAUDE_FLAGS+=(--bare)
    [[ -f "$HOME/.claude/CLAUDE.md" ]] && CLAUDE_FLAGS+=(--add-dir "$HOME/.claude")
    echo "↪ --bare aktiv + --add-dir ~/.claude (CLAUDE.md wird trotzdem gelesen)" >&2
  fi

  # ── Banner: aktives Backend ───────────────────────────────────────────────
  # User sieht beim Start sofort welches Modell aktiv ist — auch nach Auto-Switch
  # ohne dass er extra "wer bist du?" eingeben muss.
  WHOAMI=$(curl -sS --max-time 2 "$SWITCHER_URL/api/whoami" 2>/dev/null)
  if [[ -n "$WHOAMI" ]]; then
    if [[ -t 2 ]]; then
      printf '\033[1;36m▶ Aktives Backend:\033[0m \033[1m%s\033[0m\n' "$WHOAMI" >&2
    else
      echo "▶ Aktives Backend: $WHOAMI" >&2
    fi
  fi

  # ── Claude im Foreground ────────────────────────────────────────────────
  # ${arr[@]+...} expansion: Workaround für `set -u` mit leerem Bash-Array
  if [[ "$RESUME_ID" == "__continue__" ]]; then
    echo "↪ claude ${CLAUDE_FLAGS[*]:-} -c (continue last session)" >&2
    "$CLAUDE_BIN" ${CLAUDE_FLAGS[@]+"${CLAUDE_FLAGS[@]}"} -c 2> >(tee -a "$LOGFILE" >&2)
  elif [[ -n "$RESUME_ID" ]]; then
    echo "↪ claude ${CLAUDE_FLAGS[*]:-} --resume $RESUME_ID" >&2
    "$CLAUDE_BIN" ${CLAUDE_FLAGS[@]+"${CLAUDE_FLAGS[@]}"} --resume "$RESUME_ID" 2> >(tee -a "$LOGFILE" >&2)
  else
    "$CLAUDE_BIN" ${CLAUDE_FLAGS[@]+"${CLAUDE_FLAGS[@]}"} ${@+"$@"} 2> >(tee -a "$LOGFILE" >&2)
  fi
  CLAUDE_EXIT=$?

  # Beide Watcher beenden (inkl. tail-Subprozess).
  # SIGKILL statt SIGTERM, damit Bash kein 'Terminated: 15' beim Wrapper-Exit zeigt.
  # 2>/dev/null zusätzlich für den Fall dass `set +m` nicht greift (z.B. unter zsh-Aufruf).
  {
    for pid in "$WATCHER_PID" "$MARKER_WATCHER_PID"; do
      pkill -KILL -P "$pid" 2>/dev/null || true
      kill -KILL "$pid" 2>/dev/null || true
    done
    wait 2>/dev/null || true
  } 2>/dev/null

  # Restart angefordert?
  if [[ -f "$RESTART_FILE" ]]; then
    rm -f "$RESTART_FILE" "$LOGFILE"
    sid=$(find_latest_session_id)
    if [[ -n "$sid" ]]; then
      RESUME_ID="$sid"
      # Cross-Provider-Bug: Anthropic lehnt 'Invalid signature in thinking block'
      # ab wenn Session-History thinking-Blocks von anderen Modellen enthält.
      # → Beim Resume vorsichtshalber alle thinking-Blocks aus der JSONL strippen.
      strip_thinking_from_session "$sid"
    else
      echo "↪ Keine Session für $PWD gefunden, fallback auf 'claude -c' (continue last)" >&2
      RESUME_ID="__continue__"
    fi
    sleep 2
    continue
  fi

  # Normales Ende
  rm -f "$LOGFILE"
  exit "$CLAUDE_EXIT"
done
